# Self-hosting environment variables. Copy this file to `.env` and fill the
# required values. Never commit a filled `.env`.
#
# Optional integration values are commented out; uncomment only the integrations
# you actually use. No provider or integration is enabled by an empty value.
#
# Docker Compose note: `.env` only interpolates variables declared by
# compose.example.yml. That example forwards POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_DB,
# SECRET_KEY_BASE, APP_DOMAIN, FREECRYPTO_API_KEY, OPENAI_API_KEY,
# OPENCODE_GO_API_KEY, and ASSISTANT_REQUESTS_PER_HOUR. Other optional variables
# below require a Compose override (`environment:`); only AI provider keys
# support encrypted Rails credentials as an alternative. Listing values here
# alone does not enable or forward them. DB_HOST, DB_PORT, and REDIS_URL are
# set explicitly by the Compose example, not read from this file.

# --- Required ---
SELF_HOSTED=true
# Required: generate with `openssl rand -hex 64`. Keep it stable: changing it
# invalidates sessions and, when encryption keys are not set explicitly, changes
# the derived encryption material.
SECRET_KEY_BASE=

# --- App ---
PORT=3000
# Public hostname used in production email links and by the MCP endpoint's
# Host/Origin allowlist. The MCP endpoint does not derive this from requests.
APP_DOMAIN=
# Billing is enabled by default. Uncomment to disable Stripe/subscription billing
# entirely (all accounts are treated as paid).
# PAYMENTS_ENABLED=false

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=kuria_production
# Development example only. Set a strong, unique value for a production
# deployment.
POSTGRES_PASSWORD=change-me

# --- Redis ---
# Used by Action Cable (WebSockets) and Sidekiq (background jobs).
REDIS_URL=redis://localhost:6379/1
# Optional: separate Redis instance for the Rails cache store (production only).
# CACHE_REDIS_URL=redis://localhost:6379/2

# --- Email (optional) ---
SMTP_ADDRESS=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_ENABLED=true
# Replace with a sender address on a domain you own.
EMAIL_SENDER=sender@kuria.local

# --- AI (RubyLLM) ---
# AI runs exclusively through RubyLLM, calling hosted OpenAI and OpenCode Go
# APIs directly. No OpenCode Server service is required.
# Model references use the <provider>/<model> scheme (<provider> is openai or
# opencode_go). Set the key for each provider you want to use; at least one is
# required for the AI assistant. Both accounts use OpenAI-compatible Chat
# Completions only: Responses-only, Anthropic Messages, and Gemini references
# are rejected, never translated to another protocol.
OPENAI_API_KEY=
OPENCODE_GO_API_KEY=
# Provider keys are read from the environment (or encrypted deployment
# credentials); they are never stored in ordinary application settings and are
# never emitted in logs or errors.
#
# There is no default and no fixed model list: the selectable models are listed
# from each configured provider at configuration/selection time, and each user
# chooses a model explicitly per chat. An unavailable selection requires
# reselection and is never silently replaced. There are no environment overrides
# for the model name or provider API base URL.
#
# --- Live LLM compatibility smoke tests (optional, test-only) ---
# Opt-in only for the test/live suite. Do not set these for normal application
# runtime or routine CI. The live harness gates on and reads credentials only
# from OPENAI_API_KEY / OPENCODE_GO_API_KEY above; never commit them. See
# docs/hosting/docker.md for the full self-hosting and smoke-test procedure.
# KURIA_LIVE_LLM_TESTS=1
# KURIA_LIVE_OPENAI_MODEL=openai/<model>
# KURIA_LIVE_OPENCODE_GO_MODEL=opencode_go/<model>
#
# --- Assistant request limit (optional) ---
# Per-authenticated-user allowance for assistant requests (web and API), in
# requests per hour, enforced in both managed and self-hosted modes. It defaults
# to 100 when unset or blank; requests beyond the allowance are rejected before
# any LLM provider work. An invalid value (non-positive or non-integer) fails
# loudly rather than silently disabling the limit.
# ASSISTANT_REQUESTS_PER_HOUR=100

# --- MCP client endpoint (optional, independent of the LLM provider) ---
# Kuria exposes MCP at /mcp with OAuth/Doorkeeper authentication. See
# docs/hosting/mcp.md for the endpoint, scopes, and PKCE setup.
# KURIA_MCP_ACCESS_TOKEN is for the OpenCode client process only. Rails does not
# read it, and it is not passed to the web or worker services. Keep it outside
# this repository and use an OAuth token scoped mcp read or mcp read_write.
KURIA_MCP_ACCESS_TOKEN=
# Host used when generating a local OpenCode MCP client config; the port comes
# from PORT. Defaults to host.docker.internal. This is a development helper:
# do not send bearer tokens over public plain HTTP.
# OPENCODE_MCP_HOST=host.docker.internal

# --- Encryption keys (optional, derived from SECRET_KEY_BASE if unset) ---
# Generate with: bin/rails db:encryption:init
# Keep these values stable and backed up. Changing them (or SECRET_KEY_BASE when
# they are unset) can make existing encrypted data unreadable.
# Prefer encrypted Rails credentials (`RAILS_MASTER_KEY` supplied by the
# platform) for production secrets instead of this file.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Optional integrations ---
# Freecrypto exchange rates (optional; not required for self-hosting).
# FREECRYPTO_API_KEY=
#
# Synth market data (optional). SYNTH_URL is an advanced API-base override; the
# default is https://api.synthfinance.com.
# SYNTH_API_KEY=
# SYNTH_URL=https://api.synthfinance.com
#
# Stripe billing (optional). A secret key and webhook secret are both required
# for the provider; price IDs select the monthly/annual plans. Disabling billing
# with `PAYMENTS_ENABLED` disables it regardless of these values.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MONTHLY_PRICE_ID=
# STRIPE_ANNUAL_PRICE_ID=
#
# Plaid bank connections (optional). A client ID and secret are both required.
# PLAID_ENV defaults to sandbox. The EU pair requires PLAID_EU_CLIENT_ID and
# PLAID_EU_SECRET.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_EU_CLIENT_ID=
# PLAID_EU_SECRET=
#
# Error reporting and log shipping (optional, production only).
# SENTRY_DSN=
# LOGTAIL_API_KEY=
# LOGTAIL_INGESTING_HOST=
#
# Intercom support widget (optional, production only). Both values are required
# to enable it.
# INTERCOM_APP_ID=
# INTERCOM_IDENTITY_VERIFICATION_KEY=
#
# Object storage (optional; the default is local disk). Credentials alone do not
# enable object storage: select `amazon` or `cloudflare` with
# ACTIVE_STORAGE_SERVICE, and make sure the Compose override forwards the values.
# ACTIVE_STORAGE_SERVICE=amazon
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_BUCKET=
# For Cloudflare R2, set ACTIVE_STORAGE_SERVICE=cloudflare and use these instead.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKET=

# --- Production/runtime tuning (optional) ---
# Email confirmation is required by default.
# REQUIRE_EMAIL_CONFIRMATION=true
# Rails production defaults both to true. compose.example.yml explicitly sets
# both to false; change those values in a Compose override if your deployment
# needs SSL enforcement or SSL-terminating-proxy assumptions.
# RAILS_FORCE_SSL=true
# RAILS_ASSUME_SSL=true
# Defaults to info.
# RAILS_LOG_LEVEL=info
# Puma threads, database pool, and Sidekiq concurrency all default to 3.
# RAILS_MAX_THREADS=3
# Protect the Sidekiq web UI at /sidekiq in production. Set strong values; the
# initializer falls back to a weak default when these are unset.
# SIDEKIQ_WEB_USERNAME=
# SIDEKIQ_WEB_PASSWORD=

# --- Developer/test only (not production) ---
# Expose debug developer messages in chat when set to true.
# AI_DEBUG_MODE=true
# Override the base URL used for local Plaid webhook callbacks (non-production).
# DEV_WEBHOOKS_URL=http://localhost:3000

# Not included in this self-host template: managed-only REQUIRE_INVITE_CODE,
# the legacy SELF_HOSTING_ENABLED alias for SELF_HOSTED, demo-only
# DEMO_DATA_SEED, and framework/container internals (RAILS_ENV, RAILS_MASTER_KEY,
# BUNDLE_GEMFILE, PIDFILE, BUILD_COMMIT_SHA, CI). Supply those through the
# platform or container environment as appropriate; RAILS_MASTER_KEY must be
# available there to decrypt credentials, not stored inside those credentials.
