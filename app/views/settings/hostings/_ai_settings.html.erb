<div class="space-y-4">
  <div>
    <h2 class="font-medium mb-1"><%= t(".title") %></h2>
    <p class="text-secondary text-sm mb-4"><%= t(".ruby_llm_description") %></p>
  </div>
  <div class="flex items-center gap-2 mb-4">
    <div class="w-2 h-2 rounded-full <%= @ai_connected ? 'bg-green-500' : 'bg-red-500' %>"></div>
    <span class="text-sm text-secondary">
      <% if @ai_connected %>
        <%= t(".connected") %>
        <% if @ai_connected_providers.any? %>
          &mdash; <%= t(".connected_providers", providers: @ai_connected_providers.join(", ")) %>
        <% end %>
      <% else %>
        <%= t(".disconnected") %>
      <% end %>
    </span>
  </div>
  <%# RubyLLM is the only provider: credentials come from the environment and
      each user picks an available model per chat, so report the configured
      accounts instead of offering a deployment default-model selector. %>
  <p class="text-sm text-secondary">
    <%= t(@ai_connected ? ".ruby_llm_credentials_configured" : ".ruby_llm_no_credentials") %>
  </p>
  <p class="text-xs text-secondary mt-1"><%= t(".ruby_llm_environment_hint") %></p>
</div>
